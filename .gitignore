# Python bytecode from the tools/ scripts — never part of the site
__pycache__/
*.pyc

# Written by tools/set_domain.py to remember the current domain
tools/.domain

# OS cruft that must not reach a deployed folder
.DS_Store
Thumbs.db

# Downloaded source photographs. These are working files: full-size originals
# that get cropped into assets/images. Re-fetch them any time with
# `python3 tools/fetch_photos.py` — every URL is recorded in photo-pool.json.
tools/photos/
